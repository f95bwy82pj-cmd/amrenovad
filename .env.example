# Ключи доступа к API VK Рекламы: ads.vk.com → Настройки → Доступ к API
VK_ADS_CLIENT_ID=
VK_ADS_CLIENT_SECRET=

# Только для агентского кабинета: логин клиента, от имени которого получать данные
# VK_ADS_AGENCY_CLIENT_NAME=

# Необязательно: готовый access token (тогда client_id/secret не нужны)
# VK_ADS_ACCESS_TOKEN=
